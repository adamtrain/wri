/* wri: a calm place to arrange a book. */

BookScreen {
    background: $background;

    &.-narrow #preview-pane,
    &.-no-preview #preview-pane,
    &.-narrow #book-counts {
        display: none;
    }
}

#topbar {
    height: 1;
    margin-top: 1;
    padding: 0 3;

    #book-title {
        width: 1fr;
        text-wrap: nowrap;
        text-overflow: ellipsis;
    }

    #book-counts, #book-words {
        width: auto;
        text-wrap: nowrap;
    }
}

#columns {
    height: 1fr;
    padding: 0 1;
}

.column {
    height: 1fr;
    margin: 0 1;
    padding: 0;
    background: $background;
    border: round $foreground 18%;
    border-title-color: $foreground 55%;
    border-title-style: bold;
    border-subtitle-color: $foreground 45%;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $foreground 15%;
    scrollbar-color-hover: $foreground 30%;
    scrollbar-color-active: $primary;

    &:focus, &:focus-within {
        border: round $primary;
        border-title-color: $text;
        background-tint: $foreground 3%;
    }
}

BookList {
    & > .option-list--option {
        padding: 0 1;
    }
    & > .option-list--option-highlighted {
        color: $foreground;
        background: $foreground 8%;
        text-style: none;
    }
    &:focus > .option-list--option-highlighted {
        color: $text;
        background: $primary 45%;
        text-style: bold;
    }
    & > .option-list--option-disabled {
        color: $foreground 40%;
    }
}

#sections {
    width: 3fr;
    min-width: 24;
    max-width: 40;
}

#chapters {
    width: 4fr;
    min-width: 30;
    max-width: 56;
}

#preview-pane {
    width: 4fr;
    min-width: 30;
    padding: 0 2;

    #preview {
        margin: 1 0;
        padding: 0;
        background: transparent;

        MarkdownH1 {
            content-align: left middle;
            color: $text;
            background: transparent;
            text-style: bold;
            margin: 1 0;
        }
        MarkdownH2 {
            color: $text;
            background: transparent;
            text-style: bold;
            margin: 1 0;
        }
        MarkdownH3 {
            color: $text;
            background: transparent;
            text-style: bold italic;
        }
        MarkdownH4, MarkdownH5, MarkdownH6 {
            color: $foreground 75%;
            background: transparent;
            text-style: italic;
        }
    }
}

Footer {
    background: $background;
}

/* Dialogs */

TextPrompt, Confirm, SectionPicker, HelpScreen {
    align: center middle;
    background: $background 70%;
}

.dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $foreground 50%;

    .note {
        color: $foreground 60%;
        margin-bottom: 1;
    }

    Input {
        border: round $foreground 25%;
        background: $surface;
        &:focus {
            border: round $primary;
        }
    }

    .description {
        color: $foreground 55%;
        padding: 0 2;
    }

    .error {
        color: $error;
        height: auto;
        margin-top: 1;
        &:empty {
            display: none;
        }
    }

    .keys {
        color: $foreground 50%;
        margin-top: 1;
    }

    .buttons {
        height: auto;
        margin-top: 1;
        align-horizontal: right;
        Button {
            margin-left: 2;
        }
    }

    OptionList {
        height: auto;
        max-height: 20;
        border: none;
        padding: 0;
        background: transparent;
    }
}

.dialog.help {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 0 3 1 3;

    .heading {
        text-style: bold;
        color: $text;
        margin-top: 1;
    }
    .key-row {
        height: auto;
    }
    .key {
        width: 14;
        padding-left: 2;
        color: $accent;
        text-style: bold;
    }
    .meaning {
        width: 1fr;
    }
    .about {
        color: $foreground 65%;
        margin-top: 1;
    }
}
